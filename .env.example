# ==============================================================================
# VANGUARD ERP — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Self-Hosted / On-Premise / Cloud-Ready Deployments
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=production

# Server listening port (default: 3000)
PORT=3000

# Canonical Public URL of this Vanguard ERP instance.
# Used for PWA installation, external redirects, and automated SMS feedback URLs.
# Examples:
#   Local Docker:   http://localhost:3000
#   On-Premise LAN: http://192.168.1.100:3000
#   Public Domain:  https://erp.yourcompany.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. LOCAL / CONTAINERIZED POSTGRESQL 16 DATABASE
# ------------------------------------------------------------------------------
# Used by docker-compose.yml to spin up the persistent PostgreSQL service
POSTGRES_USER=vanguard
POSTGRES_PASSWORD=vanguard_secure_password
POSTGRES_DB=vanguard_erp
POSTGRES_PORT=5432

# Standard PostgreSQL connection strings (used by direct SQL clients, connection pools, and ORMs)
# For local development outside Docker:
DATABASE_URL=postgresql://vanguard:vanguard_secure_password@localhost:5432/vanguard_erp?sslmode=disable
POSTGRES_URL=postgresql://vanguard:vanguard_secure_password@localhost:5432/vanguard_erp?sslmode=disable

# For Docker containers running on the internal docker network, use host "db":
# DATABASE_URL=postgresql://vanguard:vanguard_secure_password@db:5432/vanguard_erp?sslmode=disable

# ------------------------------------------------------------------------------
# 3. SUPABASE / CLOUD REST DATABASE (OPTIONAL / HYBRID DEPLOYMENTS)
# ------------------------------------------------------------------------------
# Leave empty for pure self-hosted / air-gapped deployments.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI ASSISTANT (OPTIONAL)
# ------------------------------------------------------------------------------
# Enables the Vanguard Voice Assistant and autonomous analytical agents.
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. TELEMETRY & BUILD OPTIMIZATIONS
# ------------------------------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1
